              "type": "function_dialogue",
              "itemId": "dialogue",
              "lines": [
                {
                  "lineId": "l1",
                  "roleId": "serveur",
                  "text": "Bonjour, madame. Vous désirez ?",
                  "translation": {
                    "en": "Hello, madam. What would you like?",
                    "de": "Guten Tag. Was darf es sein?"
                  },
                  "note": {
                    "en": "A typical line at a café.",
                    "fr": "Une réplique typique au café.",
                    "de": "Ein typischer Satz im Café."
                  },
                  "expressionIds": [
                    "vous-desirez"
                  ]
                },
                {
                  "lineId": "l2",
                  "roleId": "cliente",
                  "text": "Je voudrais un thé, s’il vous plaît.",
                  "translation": {
                    "en": "I would like a tea, please.",
                    "de": "Ich hätte gern einen Tee, bitte."
                  },
                  "note": {
                    "en": "A typical line at a café.",
                    "fr": "Une réplique typique au café.",
                    "de": "Ein typischer Satz im Café."
                  },
                  "expressionIds": [
                    "je-voudrais"
                  ]
                },
                {
                  "lineId": "l3",
                  "roleId": "serveur",
                  "text": "Un thé, très bien. Et avec ceci ?",
                  "translation": {
                    "en": "A tea, very good. Anything else?",
                    "de": "Ein Tee, sehr gern. Sonst noch etwas?"
                  },
                  "note": {
                    "en": "A typical line at a café.",
                    "fr": "Une réplique typique au café.",
                    "de": "Ein typischer Satz im Café."
                  },
                  "expressionIds": [
                    "et-avec-ceci"
                  ]
                },
                {
                  "lineId": "l4",
                  "roleId": "cliente",
                  "text": "Un croissant. C’est combien ?",
                  "translation": {
                    "en": "A croissant. How much is it?",
                    "de": "Ein Croissant. Wie viel kostet das?"
                  },
                  "note": {
                    "en": "A typical line at a café.",
                    "fr": "Une réplique typique au café.",
                    "de": "Ein typischer Satz im Café."
                  },
                  "expressionIds": [
                    "cest-combien"
                  ]
                },
                {
                  "lineId": "l5",
                  "roleId": "serveur",
                  "text": "Quatre euros cinquante.",
                  "translation": {
                    "en": "Four euros fifty.",
                    "de": "Vier Euro fünfzig."
                  },
                  "note": {
                    "en": "A typical line at a café.",
                    "fr": "Une réplique typique au café.",
                    "de": "Ein typischer Satz im Café."
                  },
                  "expressionIds": []
                },
                {
                  "lineId": "l6",
                  "roleId": "cliente",
                  "text": "Voilà. L’addition, s’il vous plaît.",
                  "translation": {
                    "en": "Here you are. The bill, please.",
                    "de": "Bitte schön. Die Rechnung, bitte."
                  },
                  "note": {
                    "en": "A typical line at a café.",
                    "fr": "Une réplique typique au café.",
                    "de": "Ein typischer Satz im Café."
                  },
                  "expressionIds": [
                    "laddition"
                  ]
                },
                {
                  "lineId": "l7",
                  "roleId": "serveur",
                  "text": "Voilà, madame. Bonne journée !",
                  "translation": {
                    "en": "Here you are, madam. Have a nice day!",
                    "de": "Bitte schön. Einen schönen Tag!"
                  },
                  "note": {
                    "en": "A typical line at a café.",
                    "fr": "Une réplique typique au café.",
                    "de": "Ein typischer Satz im Café."
                  },
                  "expressionIds": []
                },
                {
                  "lineId": "l8",
                  "roleId": "cliente",
                  "text": "Merci, au revoir.",
                  "translation": {
                    "en": "Thank you, goodbye.",
                    "de": "Danke, auf Wiedersehen."
                  },
                  "note": {
                    "en": "A typical line at a café.",
                    "fr": "Une réplique typique au café.",
                    "de": "Ein typischer Satz im Café."
                  },
                  "expressionIds": [
                    "merci-au-revoir"
                  ]
                }
              ]
            }
          ]
