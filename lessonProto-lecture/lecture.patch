+import { nativeLocales } from '../schemas/artifactCommon.ts';
+import type { Level } from '../schemas/common.ts';
+import {
+  documentWords,
+  examWordRange,
+  NOT_STATED_LEVELS,
+  READING_LIMITS,
+  READING_SKIM_SECONDS,
+  READING_STAGES,
+  READING_WORDS,
+  type ReadingBrief,
+  type ReadingContent,
+  type ReadingDocument,
+  type ReadingItem,
