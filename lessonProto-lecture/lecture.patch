+/** C1: an original press release announcing a factory closure in euphemisms; the exam reads a bank’s release on closing branches. */
+export default {
+  id: 'fr-reading-a-press-release',
+  genre: 'article',
+  objective: L('Read a company’s press release about closing a factory and spot what its phrases (reorganisation, adaptation, job protection plan) avoid saying.', 'Lire le communiqué d’une entreprise qui ferme une usine et repérer ce que les formules (réorganisation, adaptation, plan de sauvegarde de l’emploi) évitent de dire.', 'Die Pressemitteilung eines Unternehmens über eine Werksschließung lesen und erkennen, was die Formulierungen (Reorganisation, Anpassung, Sozialplan) verschweigen.'),
+  situation: L('A household appliance group announces its strategic plan to the press; the plan closes a factory in Burgundy.', 'Un groupe d’électroménager annonce son plan stratégique à la presse ; le plan ferme une usine en Bourgogne.', 'Ein Haushaltsgerätekonzern stellt der Presse seinen Strategieplan vor; der Plan schließt ein Werk in Burgund.'),
