@@ -0,0 +1,133 @@
+import { choice, headings, L, short, tf, type ReadingDefinition } from '../../scripts/author-reading-items.ts';
+
+/** C2: an original defence plea before a jury; the exam reads an original plea before a criminal court. */
+export default {
+  id: 'fr-reading-a-courtroom-plea',
+  genre: 'speech',
+  objective: L('Read a lawyer’s plea, follow its strategy (moving the jury, sowing doubt, turning the accusation around) and spot its oratorical effects (Mesdames et Messieurs les jurés, regardez-le).', 'Lire une plaidoirie d’avocat, en suivre la stratégie (attendrir, semer le doute, retourner l’accusation) et repérer les effets oratoires (Mesdames et Messieurs les jurés, regardez-le).', 'Ein Plädoyer lesen, seiner Strategie folgen (rühren, Zweifel säen, die Anklage umkehren) und die rhetorischen Mittel erkennen (Mesdames et Messieurs les jurés, regardez-le).'),
+  situation: L('At the end of an arson trial in Lyon, the defence lawyer addresses the jury before it retires.', 'À la fin d’un procès pour incendie à Lyon, l’avocate de la défense s’adresse aux jurés avant qu’ils se retirent.', 'Am Ende eines Brandstiftungsprozesses in Lyon wendet sich die Verteidigerin an die Geschworenen, bevor sie sich zurückziehen.'),
+  readerTask: L('Follow each move of the plea, judge how it treats the evidence and notice what it implies without saying.', 'Suivre chaque mouvement de la plaidoirie, voir comment elle traite les preuves et remarquer ce qu’elle suggère sans le dire.', 'Jedem Schritt des Plädoyers folgen, ihren Umgang mit den Beweisen beurteilen und bemerken, was sie andeutet, ohne es zu sagen.'),
+  coverageNotes: L('Oratory devices (address, anaphora, rhetorical questions, ternary rhythm, imperatives), the vocabulary of a criminal trial, implication versus accusation. Not covered: criminal procedure in detail.', 'Procédés oratoires (apostrophe, anaphore, questions rhétoriques, rythme ternaire, impératifs), vocabulaire du procès pénal, insinuation et accusation. Non traité : la procédure pénale en détail.', 'Rhetorische Mittel (Anrede, Anapher, rhetorische Fragen, Dreierrhythmus, Imperative), Wortschatz des Strafprozesses, Andeutung statt Anklage. Nicht behandelt: das Strafverfahren im Detail.'),
+  prerequisites: [L('The conditional (l’aurait vu)', 'Le conditionnel (l’aurait vu)', 'Der Konditional (l’aurait vu)'), L('Legal vocabulary', 'Le vocabulaire juridique', 'Juristischer Wortschatz')],
+  keywords: [
+    { id: 'jures', term: 'les jurés', translations: { en: ['the jurors', 'the jury'], de: ['die Geschworenen'] }, explanation: L('Citizens drawn by lot who judge serious crimes with the professional judges.', 'Des citoyens tirés au sort qui jugent les crimes avec les juges professionnels.', 'Ausgeloste Bürger, die mit Berufsrichtern schwere Verbrechen beurteilen.'), matching: L('les jurés = the jurors.', 'les jurés : les citoyens qui jugent.', 'les jurés = die Geschworenen.') },
+    { id: 'incendiaire', term: 'un incendiaire', translations: { en: ['an arsonist'], de: ['ein Brandstifter'] }, explanation: L('Someone who sets fire to something on purpose.', 'Quelqu’un qui met le feu exprès.', 'Jemand, der absichtlich Feuer legt.'), matching: L('un incendiaire = an arsonist.', 'un incendiaire : celui qui met le feu.', 'un incendiaire = Brandstifter.') },
+    { id: 'mobile', term: 'le mobile', translations: { en: ['the motive'], de: ['das Motiv'] }, explanation: L('The reason that would push someone to commit a crime.', 'La raison qui pousserait quelqu’un à commettre un crime.', 'Der Grund, der jemanden zu einer Tat treiben würde.'), matching: L('le mobile = the motive.', 'le mobile : la raison du crime.', 'le mobile = das Motiv.') },
+    { id: 'a-qui-profite', term: 'à qui profite… ?', translations: { en: ['who benefits from…?'], de: ['wem nützt…?'] }, explanation: L('The classic question of investigators: who gains from the crime is a suspect.', 'La question classique de l’enquête : celui qui gagne au crime est suspect.', 'Die klassische Ermittlerfrage: Wer vom Verbrechen profitiert, ist verdächtig.'), matching: L('à qui profite… ? = who benefits?', 'à qui profite… ? : qui y gagne ?', 'à qui profite… ? = wem nützt es?') },
+    { id: 'sinistre', term: 'le sinistre', translations: { en: ['the disaster', 'the insured loss'], de: ['der Schadensfall'] }, explanation: L('In insurance language: the fire, flood or accident that causes the damage.', 'Dans la langue des assurances : l’incendie, l’inondation ou l’accident qui cause les dégâts.', 'In der Versicherungssprache: das Feuer, Hochwasser oder der Unfall, der den Schaden verursacht.'), matching: L('le sinistre = the insured disaster.', 'le sinistre : l’accident assuré.', 'le sinistre = Schadensfall.') },
+    { id: 'acquittez', term: 'acquittez', translations: { en: ['acquit'], de: ['sprechen Sie frei'] }, explanation: L('Declare the accused not guilty; from acquitter.', 'Déclarez l’accusé non coupable ; du verbe acquitter.', 'Den Angeklagten für nicht schuldig erklären; von acquitter.'), matching: L('acquittez = acquit, declare not guilty.', 'acquittez : déclarez non coupable.', 'acquittez = sprechen Sie frei.') },
+  ],
+  main: {
+    contents: L('A defence plea in five movements: the opening turns the jury’s eyes from the fire to the man (regardez-le); his hard life and six years of loyal work (is this an arsonist?); the three pieces of evidence taken apart one by one (a hooded figure seen from behind, a motive cancelled by a new contract, a witness without his glasses); the reversal: who benefits? a company near bankruptcy, over-insured, never questioned, with a faulty electrical room – without accusing anyone; the final appeal to doubt and the request for acquittal.', 'Une plaidoirie en cinq mouvements : l’exorde détourne le regard des jurés de l’incendie vers l’homme (regardez-le) ; sa vie difficile et six ans de travail fidèle (est-ce là un incendiaire ?) ; les trois preuves démontées une à une (une silhouette de dos, un mobile annulé par un nouveau contrat, un témoin sans lunettes) ; le retournement : à qui profite l’incendie ? une société au bord de la faillite, surassurée, jamais entendue, au local électrique défectueux – sans accuser personne ; l’appel final au doute et la demande d’acquittement.', 'Ein Plädoyer in fünf Schritten: Die Einleitung lenkt den Blick der Geschworenen vom Feuer auf den Menschen (regardez-le); sein schweres Leben und sechs Jahre treuer Arbeit (ist das ein Brandstifter?); die drei Beweise werden einzeln zerlegt (eine Gestalt von hinten, ein durch einen neuen Vertrag entkräftetes Motiv, ein Zeuge ohne Brille); die Wende: Wem nützt der Brand? Einer Firma kurz vor der Pleite, überversichert, nie vernommen, mit defektem Elektroraum – ohne jemanden anzuklagen; der Schlussappell an den Zweifel und die Bitte um Freispruch.'),
+    title: 'Plaidoirie pour Lucas Moreau',
+    meta: ['Cour d’assises du Rhône · audience du 12 mai', 'Maître Hélène Garnier, avocate de la défense'],
+    parts: [
+      { id: 'm-opening', segments: [
+        'Mesdames et Messieurs les jurés, Monsieur le Président, depuis trois jours, on vous parle d’un incendie, d’un entrepôt détruit, de deux millions d’euros de dégâts.',
+        'Depuis trois jours, on vous parle de tout, sauf de l’homme qui est assis là, devant vous.',
+        'Un garçon qui risque dix ans de sa vie sur une ombre.',
+        'Alors, avant de juger, regardez-le.',
+      ] },
+      { id: 'm-life', segments: [
+        'Lucas Moreau a vingt-quatre ans.',
+        'Il a perdu sa mère à onze ans et il a élevé seul sa petite sœur pendant que son père enchaînait les chantiers loin de Lyon.',
+        'À seize ans, il quittait le lycée pour travailler ; à dix-huit, il entrait comme magasinier dans cet entrepôt qu’on l’accuse aujourd’hui d’avoir brûlé.',
+        'Six ans sans un retard, sans une absence : son chef d’équipe est venu vous le dire à cette barre.',
+        'Le soir de l’incendie, il était chez lui ; sa sœur l’a dit, et on a refusé de la croire parce qu’elle est sa sœur.',
+        'Est-ce là le portrait d’un incendiaire ?',
+      ] },
+      { id: 'm-doubt', segments: [
+        'L’accusation vous a présenté trois éléments.',
+        'Une vidéo, d’abord : une silhouette en capuche, de dos, à vingt-trois heures quarante.',
+        'La caméra n’a filmé aucun visage, aucune voiture, aucune plaque.',
+        'Combien d’hommes à Lyon possèdent un sweat gris à capuche ?',
+        'Des milliers, Mesdames et Messieurs, et je crains même qu’il n’y en ait un ou deux dans cette salle.',
+        'Un mobile, ensuite : Lucas venait d’apprendre son licenciement.',
+        'Mais on oublie de vous dire qu’il avait déjà signé un contrat chez un autre employeur, qui commençait le lundi suivant.',
+        'Un témoin, enfin, qui l’aurait vu près du quai de chargement ; ce même témoin qui, devant les enquêteurs, avait d’abord déclaré qu’il ne portait pas ses lunettes.',
+        'Voilà le dossier : une ombre, un faux mobile et un témoin myope.',
+      ] },
+      { id: 'm-reversal', segments: [
+        'Car la vraie question, celle que personne n’a voulu poser, la voici : à qui profite cet incendie ?',
+        'Pas à Lucas, qui y a perdu son dernier salaire et ses affaires restées au vestiaire.',
+        'Mais à une société au bord de la faillite, dont l’assurance couvrait le bâtiment pour le double de sa valeur, et dont les comptes ont été remis à la justice trois semaines après le sinistre.',
+        'Pourquoi ses dirigeants n’ont-ils jamais été entendus comme témoins ?',
+        'Pourquoi l’expert en incendie n’a-t-il examiné que la porte du vestiaire, et pas le local électrique, signalé défectueux un mois plus tôt ?',
+        'Je n’accuse personne ; je constate seulement que l’enquête s’est arrêtée là où elle aurait dû commencer.',
+      ] },
+      { id: 'm-final', segments: [
+        'Mesdames et Messieurs les jurés, le doute n’est pas une faiblesse de la justice : c’est sa garantie.',
+        'La loi vous le dit, et votre conscience vous le dira ce soir : s’il reste un doute, un seul, il doit profiter à l’accusé.',
+        'Vous allez entrer dans la salle des délibérations avec une seule question : êtes-vous sûrs ?',
+        'Pas convaincus, pas troublés, pas impressionnés par les mots de l’accusation : sûrs.',
+        'Car demain, quand cette salle sera vide, c’est lui qui vivra avec votre décision, pas nous.',
