# Offline generator only. Copy to .env and configure GEMINI_API_KEY and GEMINI_MODEL.
# One or more keys separated by commas; later keys are used in order when a key's quota is exhausted.
GEMINI_API_KEY=
# Gemini models with structured JSON output, best first, separated by commas.
# Every key is tried three times per model before the next model takes over.
GEMINI_MODEL=
# Batch targets (briefs-missing, sample-briefs): briefs generated at once (1–8, default 1 = serial)
# and the delay between worker starts in seconds (default 30).
GEMINI_CONCURRENCY=1
GEMINI_WORKER_STAGGER_S=30
