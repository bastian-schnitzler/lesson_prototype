  "theme": "personal_identification",
  "coverageNotes": {
    "en": "Covers the full finite set of cardinal numbers from 0 to 20, with special focus on pronunciation of final consonants in six, dix, and vingt.",
    "fr": "Couvre l'ensemble fini des nombres cardinaux de 0 à 20, avec une attention particulière à la prononciation des consonnes finales de six, dix et vingt.",
    "de": "Deckt die vollständige endliche Menge der Grundzahlen von 0 bis 20 ab, mit besonderem Augenmerk auf die Aussprache der Endkonsonanten von six, dix und vingt."
  },
  "targetCount": 21,
  "countRationale": {
    "en": "Numbers from 0 to 20 form a fundamental complete group required for everyday basic counting and room or phone identification.",
    "fr": "Les nombres de 0 à 20 constituent un ensemble fondamental complet indispensable pour compter au quotidien et identifier des numéros.",
    "de": "Die Zahlen von 0 bis 20 bilden eine grundlegende vollständige Gruppe, die für alltägliches Zählen und Zimmer- oder Telefonnummern notwendig ist."
  },
  "difficultyBalance": {
    "en": "Numbers 0-10 are core foundational words; numbers 11-16 and 17-20 are demanding due to irregular endings and compound hyphenated spelling.",
    "fr": "Les nombres de 0 à 10 sont essentiels; les nombres de 11 à 16 et de 17 à 20 sont plus exigeants en raison des terminaisons irrégulières et des formes composées.",
    "de": "Die Zahlen 0-10 sind grundlegend; die Zahlen 11-16 und 17-20 sind aufgrund unregelmäßiger Endungen und Bindestrich-Schreibweisen anspruchsvoller."
  },
